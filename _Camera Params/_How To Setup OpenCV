INSTALL OPENCV
0. (Not sure if needed) for GUI application, install GTK
sudo apt install libgtk-3-dev
sudo apt install libgtk2.0-dev
conda install -c conda-forge libstdcxx-ng
conda install scipy pyserial ruckig flask-cors
1. create a conda environment named 'cv', python=3.12 command: conda create -n cv python=3.12
2. install numpy into the environment
3. Clone opencv, opencv-contrib
4. Make a dir to contain the build files
5. CD into this dir
6. Run the following command (double-check python paths):
# reason for including OPENCV_GENERATE_PKGCONFIG: https://github.com/opencv/opencv/issues/13154#issuecomment-456652297
# Double check the PYTHON3_NUMPY_INCLUDE_DIRS are correct (it exist)

cmake \
-D CMAKE_BUILD_TYPE=RELEASE \
-D CMAKE_INSTALL_PREFIX=/usr/local \
-D PYTHON3_LIBRARIES=~/miniconda3/envs/cv/lib \
-D PYTHON3_EXECUTABLE=~/miniconda3/envs/cv/bin/python \
-D PYTHON3_INCLUDE_DIR=~/miniconda3/envs/cv/include/python3.12 \
-D PYTHON3_PACKAGES_PATH=~/miniconda3/envs/cv/lib/python3.12/site-packages \
-D PYTHON3_NUMPY_INCLUDE_DIRS=~/miniconda3/envs/cv/lib/python3.12/site-packages/numpy/_core/include \
-D BUILD_opencv_python2=OFF \
-D BUILD_opencv_python3=ON \
-D INSTALL_PYTHON_EXAMPLES=ON \
-D INSTALL_C_EXAMPLES=OFF \
-D WITH_QT=OFF \
-D WITH_GTK=ON \
-D OPENCV_ENABLE_NONFREE=ON \
-D OPENCV_GENERATE_PKGCONFIG=YES \
-D OPENCV_EXTRA_MODULES_PATH=../opencv_contrib/modules/ ../opencv

make -j
sudo make install

